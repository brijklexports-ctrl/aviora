# Postgres connection (populated automatically when you `vercel env pull`
# after attaching a Vercel Postgres / Neon database to this project).
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Secret used to authorize calls to /api/sync (cron and manual triggers).
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# The catalog you're mirroring, from its gembox.app URL:
# https://gembox.app/catalog/<this-id>
GEMBOX_CATALOG_UUID=mnix9bljni

# Your brand, used across the site.
NEXT_PUBLIC_SITE_NAME="Aviora Jewelry"
